# never commit credentials
*gh-credentials*
*.token
.credentials.json
# noise
.DS_Store
Thumbs.db

# Binary assets shipped inside skills (fonts, audio, images, video, archives).
# They are stock files that come back when the skill is reinstalled, so the
# mirror stays text-only: smaller repo, no third-party media redistributed, and
# the binary guard in scripts/sync.sh has nothing to trip over.
claude/skills/**/*.woff
claude/skills/**/*.woff2
claude/skills/**/*.ttf
claude/skills/**/*.otf
claude/skills/**/*.mp3
claude/skills/**/*.wav
claude/skills/**/*.ogg
claude/skills/**/*.m4a
claude/skills/**/*.mp4
claude/skills/**/*.mov
claude/skills/**/*.webm
claude/skills/**/*.png
claude/skills/**/*.jpg
claude/skills/**/*.jpeg
claude/skills/**/*.gif
claude/skills/**/*.webp
claude/skills/**/*.ico
claude/skills/**/*.pdf
claude/skills/**/*.zip
claude/skills/**/*.wasm
